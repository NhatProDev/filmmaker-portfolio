# OS
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Office lock files (the human description is a .docx)
~$*

# Vercel
.vercel

# Local-only design references — intentionally NOT version-controlled.
# These are required local design inputs and carry tier-2 design authority
# (CLAUDE.md §21), but the image files themselves are held locally rather than
# in Git. docs/human-description/references/INDEX.md is the tracked manifest
# describing them; a fresh clone must restore these images manually.
docs/human-description/references/*.png

# Local working/prototype media — intentionally NOT version-controlled.
# Footage used for Home visual and media testing. Held locally, never in Git:
# it is large, it is working material rather than a source-controlled fixture,
# and production media will live in object storage (CLAUDE.md §12), not here.
# docs/design/prototypes/home/MEDIA.md is the tracked manifest describing it;
# a fresh clone must restore these assets manually.
imgs & videos/

# Deliberately NOT ignored:
#   docs/human-description/references/INDEX.md       tracked manifest
#   docs/human-description/description.source.docx   signed-off source of record
#   docs/design/prototypes/home/MEDIA.md             tracked manifest
#   db/migrations/*.sql                              persistence contract

# Local runtime media for archived design prototypes
/media/

# Local copies of runtime media used by implemented pages. Same local-only
# policy as /media/: never committed. A fresh clone must restore them by copying
# from media/w/ and media/clips/ into public/media/<page>/ (About uses
# portrait.jpg, desk-01.jpg and mtm-atelier.jpg; Home's files are listed in
# src/content/home.ts).
/public/media/

# Local preview tooling: this machine's launch configurations for the dev,
# production and prototype servers. Never committed.
/.claude/launch.json
