# Copy to .env.local for local development. Never commit real values.

# Where public content comes from: "static" (the default; no database needed)
# or "db". Pages are prerendered, so this is read when `next build` runs.
SITE_CONTENT_ADAPTER=static

# Required when SITE_CONTENT_ADAPTER=db, and by `npm run db:migrate` and
# `npm run db:import`. Those two commands write only to a local development
# database (localhost, 127.0.0.1, ::1 or a local socket).
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/portfolio
# DATABASE_POOL_MAX=10
# Set to false behind a transaction-mode connection pooler.
# DATABASE_PREPARE=true

# Where media keys are served from. Unset, they resolve under /media, the local
# public/media folder.
# MEDIA_PUBLIC_BASE_URL=/media

# Extra origins accepted by the CSRF check on API mutations, comma-separated,
# when the site answers under more than one host name. The request's own origin
# is always accepted.
# APP_ORIGINS=https://www.example.com,https://example.com

# Signs private-project access cookies (32+ random characters). Without it, no
# private project can be unlocked. Generate one, e.g.
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
# PROJECT_ACCESS_SECRET=

# The initial admin, read only by `npm run db:seed-admin` (never by the app).
# Use a long unique password; it is hashed with Argon2id and never printed.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=

# The public origin: canonical links, the sitemap, Open Graph, HSTS. Read at
# build time. Required in production (https).
# SITE_URL=https://www.example.com

# Which client address rate limits trust. Set exactly one in production:
# a header the platform always overwrites (x-real-ip on Vercel,
# cf-connecting-ip behind Cloudflare, fly-client-ip on Fly.io), or the number
# of reverse proxies appending to X-Forwarded-For. With neither, forwarded
# headers are ignored (fine locally).
# CLIENT_IP_HEADER=x-real-ip
# TRUSTED_PROXY_HOPS=0

# Media storage (docs/operations/media-migration.md). "local" serves public
# keys from public/media and private keys (private/...) from
# MEDIA_PRIVATE_ROOT, outside public/. "s3" is any S3-compatible store
# (Cloudflare R2, AWS S3) with a public and a private bucket.
# MEDIA_STORAGE_PROVIDER=local
# MEDIA_PRIVATE_ROOT=storage/private
# MEDIA_SIGNED_URL_TTL_SECONDS=300
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PUBLIC_BUCKET=
# S3_PRIVATE_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Have the provider verify each upload's SHA-256 (signed x-amz-checksum-sha256).
# Turn on only after both buckets' CORS allow that header
# (docs/operations/media-lifecycle.md §4).
# S3_UPLOAD_CHECKSUMS=false

# Reserved for a hosted video provider; only "none" is implemented in V1.
# VIDEO_PROVIDER=none
