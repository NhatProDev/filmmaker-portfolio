# Normalize text to LF in the index and in the working tree on every platform.
# Overrides core.autocrlf, which is `true` on the current Windows machine.
* text=auto eol=lf

# Binary — never diffed, never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.docx binary

# Video — local prototype media (see docs/design/prototypes/home/MEDIA.md).
# Declared explicitly so it never relies on content heuristics under `text=auto`.
*.mp4 binary
