# Copy to .env.local for local development. Never commit real values.

# Where public content comes from: "static" (the default; no database needed)
# or "db". Pages are prerendered, so this is read when `next build` runs.
SITE_CONTENT_ADAPTER=static

# Required when SITE_CONTENT_ADAPTER=db, and by `npm run db:migrate` and
# `npm run db:import`. Those two commands write only to a local development
# database (localhost, 127.0.0.1, ::1 or a local socket).
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/portfolio
# DATABASE_POOL_MAX=10
# Set to false behind a transaction-mode connection pooler.
# DATABASE_PREPARE=true

# Where media keys are served from. Unset, they resolve under /media, the local
# public/media folder.
# MEDIA_PUBLIC_BASE_URL=/media
