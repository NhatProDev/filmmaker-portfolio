{
  "name": "filmmaker-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:import": "tsx --env-file-if-exists=.env.local scripts/import-static-content.ts",
    "db:seed-admin": "tsx --env-file-if-exists=.env.local scripts/seed-admin.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "js-yaml": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
